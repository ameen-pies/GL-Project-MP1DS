# Database (SQLite files are relative to the backend/ directory)
DATABASE_URL=sqlite:///./fleet.db
TEST_DATABASE_URL=sqlite:///./fleet_test.db

# Auth
SECRET_KEY=change-me-in-real-life
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Same-origin in this build: FastAPI serves the frontend and the API.
CORS_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Mail (Mailpit planned for SCRUM-30)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@fleet-control.local

# Seed accounts
SEED_ADMIN_PASSWORD=Admin123!
SEED_OPERATOR_PASSWORD=Operator123!
